# syntax=docker/dockerfile:1

# Build natively and cross-compile: no QEMU per target architecture.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder
WORKDIR /src

ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Static binary.
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/chaincode ./cmd/chaincode

# No ca-certificates: the chaincode makes no outbound call.
FROM alpine:3.23 AS runner

COPY --from=builder /out/chaincode /app/chaincode

RUN addgroup -S app && adduser -S -G app app
USER app

EXPOSE 9999

# No HEALTHCHECK: the peer dials this gRPC server, so readiness is its connection.

ENTRYPOINT ["/app/chaincode"]
